  {
    "fields": [
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "description": "A short internal/display title for this media item.",
        "name": "title",
        "type": "string"
      },
      {
        "initialValue": "image",
        "options": {
          "layout": "radio",
          "list": [
            {
              "title": "Image",
              "value": "image"
            },
            {
              "title": "Video",
              "value": "video"
            }
          ]
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "image",
                  "video"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "mediaType",
        "type": "string",
        "title": "Media type"
      },
      {
        "options": {
          "hotspot": true
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "custom"
              }
            ]
          }
        ],
        "hidden": "conditional",
        "name": "image",
        "type": "image"
      },
      {
        "options": {
          "accept": "video/mp4,video/quicktime,video/webm"
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "custom"
              }
            ]
          }
        ],
        "hidden": "conditional",
        "name": "video",
        "type": "file"
      },
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "max",
                "constraint": 180
              }
            ]
          }
        ],
        "description": "Describe the image for accessibility. Keep it concise and factual.",
        "hidden": "conditional",
        "name": "altText",
        "type": "string",
        "title": "Alternative text"
      },
      {
        "rows": 3,
        "name": "caption",
        "type": "text"
      },
      {
        "description": "Optional location, lodge, park, or region shown with the media.",
        "name": "location",
        "type": "string"
      },
      {
        "initialValue": true,
        "description": "Images with this enabled appear on /gallery. Videos are stored for future use and are not shown on the gallery page yet.",
        "hidden": "conditional",
        "name": "showInGallery",
        "type": "boolean",
        "title": "Show in website gallery"
      },
      {
        "options": {
          "layout": "radio",
          "list": [
            {
              "title": "Portrait / mobile",
              "value": "portrait"
            },
            {
              "title": "Landscape / desktop",
              "value": "landscape"
            },
            {
              "title": "Square",
              "value": "square"
            }
          ]
        },
        "description": "Helps us decide later where portrait/mobile and landscape videos should be used.",
        "hidden": "conditional",
        "name": "videoOrientation",
        "type": "string",
        "title": "Video orientation"
      },
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "min",
                "constraint": 0
              }
            ]
          }
        ],
        "description": "Lower numbers appear first. Leave blank to fall back to newest-first ordering.",
        "name": "sortOrder",
        "type": "number",
        "title": "Sort order"
      }
    ],
    "name": "galleryMedia",
    "type": "document"
  }
